# Copy to .env only for development. Production config lives in
# ~/Library/Application Support/Mastisk/config.toml (written by `mastisk init`).

# Ollama Cloud (optional; leave empty to use local Ollama or the CLI providers)
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_CLOUD_KEY=

# Local Ollama fallback
OLLAMA_LOCAL_URL=http://localhost:11434

# Claude CLI — auto-detected from PATH; override if using a specific build
CLAUDE_CMD=claude

# Server
MASTISK_HOST=0.0.0.0
MASTISK_PORT=5555

# Override the vault path (default: iCloud Drive if available, else Application Support)
# MASTISK_VAULT=/path/to/vault

# Override everything (overrides all auto-detection)
# MASTISK_HOME=/path/to/mastisk-home
